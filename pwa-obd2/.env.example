# Copia questo file in `.env.local` (nella stessa cartella pwa-obd2/) e
# metti la tua API key OpenAI. Il file `.env.local` è in .gitignore e NON
# finisce mai nel repo Git.
#
# Dopo aver salvato .env.local, riavvia `npm run dev` per ricaricare le
# variabili d'ambiente.
#
# In alternativa puoi lasciare vuoto questo file e inserire la chiave
# direttamente dall'app in Impostazioni (viene salvata in localStorage del
# tuo browser).

VITE_OPENAI_API_KEY=sk-proj-la-tua-chiave-qui
